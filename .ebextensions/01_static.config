option_settings:
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: config.settings
    DJANGO_DEBUG: "False"
    # Keep the SQLite database outside the app folder, which every deploy
    # replaces; otherwise each deploy starts with an empty database.
    # 02_database.config creates this file. (Ignored once RDS_* is set.)
    SQLITE_DB_PATH: /var/app/data/db.sqlite3
  # With DEBUG off Django no longer serves uploaded photos, so nginx does.
  aws:elasticbeanstalk:environment:proxy:staticfiles:
    /media: media

container_commands:
  # --clear rebuilds staticfiles/ from scratch so every deploy serves the current CSS and JS.
  01_collectstatic:
    command: "python manage.py collectstatic --noinput --clear"