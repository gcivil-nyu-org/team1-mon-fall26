option_settings:
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: config.settings
    DJANGO_DEBUG: "False"
    # Keep the SQLite database outside the app folder, which every deploy
    # replaces; otherwise each deploy starts with an empty database.
    # 02_database.config creates this file. (Ignored once RDS_* is set.)
    SQLITE_DB_PATH: /var/app/data/db.sqlite3
  # With DEBUG off Django no longer serves uploaded photos, so nginx does.
  # CSS and JS (/static) are served by WhiteNoise in Django: mapping /static
  # here too made nginx answer with 404s and the live site lost its styling.
  aws:elasticbeanstalk:environment:proxy:staticfiles:
    /media: media

container_commands:
  # This server's own secret key (#316), kept next to the database so it stays
  # the same between deploys. Made here, before any manage.py command, so the
  # web app's user owns it (settings.py would make it as root otherwise).
  00_secret_key:
    command: "mkdir -p /var/app/data && (test -s /var/app/data/secret_key || python3 -c 'import secrets; print(secrets.token_urlsafe(50))' > /var/app/data/secret_key) && chown webapp:webapp /var/app/data/secret_key && chmod 600 /var/app/data/secret_key"
  # --clear rebuilds staticfiles/ from scratch so every deploy serves the current CSS and JS.
  01_collectstatic:
    command: "python manage.py collectstatic --noinput --clear"
