
container_commands:
  01_migrate:
    command: "python manage.py migrate --noinput"
    leader_only: true
  02_create_superuser:
    command: "python manage.py shell -c \"import os; from django.contrib.auth import get_user_model; U=get_user_model(); username=os.environ['DEMO_ADMIN_USERNAME']; password=os.environ['DEMO_ADMIN_PASSWORD']; user,created=U.objects.get_or_create(username=username, defaults={'is_staff':True,'is_superuser':True}); user.is_staff=True; user.is_superuser=True; user.set_password(password); user.save()\""
    leader_only: true
