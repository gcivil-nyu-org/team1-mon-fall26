
container_commands:
  00_prepare_sqlite:
    command: "mkdir -p /var/app/data && touch /var/app/data/db.sqlite3 && chown webapp:webapp /var/app/data && chown webapp:webapp /var/app/data/db.sqlite3 && chmod 755 /var/app/data && chmod 664 /var/app/data/db.sqlite3"
  01_migrate:
    command: "python manage.py migrate --noinput"
    leader_only: true
  # Refresh the Explore map's dog parks from NYC Open Data. If it can't be
  # reached, the deploy carries on with the dog parks already saved.
  01b_import_dog_runs:
    command: "python manage.py import_dog_runs || true"
    leader_only: true
  # Off-leash areas from NYC Parks, the same way: kept as they are if it fails.
  01c_import_off_leash_areas:
    command: "python manage.py import_off_leash_areas || true"
    leader_only: true
  01d_import_dog_fountains:
    command: "python manage.py import_dog_fountains || true"
    leader_only: true
  # Outdoor dining from NYC DOT's Dining Out NYC (about 2,000 places, ~10 s).
  01e_import_outdoor_dining:
    command: "python manage.py import_outdoor_dining || true"
    leader_only: true
  02_create_superuser:
    command: "python manage.py shell -c \"import os; from django.contrib.auth import get_user_model; U=get_user_model(); username=os.environ['DEMO_ADMIN_USERNAME']; password=os.environ['DEMO_ADMIN_PASSWORD']; user,created=U.objects.get_or_create(username=username, defaults={'is_staff':True,'is_superuser':True}); user.is_staff=True; user.is_superuser=True; user.set_password(password); user.save()\""
    leader_only: true
  03_create_testing_party:
    command: "if [ \"$ENABLE_EVALUATOR_ACCOUNTS\" = \"true\" ] && [ -n \"$EVALUATOR_PASSWORDS_JSON\" ]; then python manage.py create_testing_party --allow-production; else echo 'Evaluator account setup skipped'; fi"
    leader_only: true

commands:
  01_prepare_database_directory:
    command: "mkdir -p /var/app/data && chown webapp:webapp /var/app/data && chmod 755 /var/app/data"


  