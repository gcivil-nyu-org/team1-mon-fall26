
container_commands:
  00_prepare_sqlite:
    command: "mkdir -p /var/app/data && touch /var/app/data/db.sqlite3 && chown webapp:webapp /var/app/data && chown webapp:webapp /var/app/data/db.sqlite3 && chmod 755 /var/app/data && chmod 664 /var/app/data/db.sqlite3"
  01_migrate:
    command: "python manage.py migrate --noinput"
    leader_only: true
  02_create_superuser:
    command: "python manage.py shell -c \"import os; from django.contrib.auth import get_user_model; U=get_user_model(); username=os.environ['DEMO_ADMIN_USERNAME']; password=os.environ['DEMO_ADMIN_PASSWORD']; user,created=U.objects.get_or_create(username=username, defaults={'is_staff':True,'is_superuser':True}); user.is_staff=True; user.is_superuser=True; user.set_password(password); user.save()\""
    leader_only: true

commands:
  01_prepare_database_directory:
    command: "mkdir -p /var/app/data && chown webapp:webapp /var/app/data && chmod 755 /var/app/data"
  02_prepare_media_directory:
    command: "mkdir -p /var/app/data/media && chown webapp:webapp /var/app/data/media && chmod 755 /var/app/data/media"


  